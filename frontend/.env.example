# ====== Supabase (đã có) ======
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# ====== BÍ MẬT - chỉ đặt trên server (Vercel Env / VPS). KHÔNG có tiền tố NEXT_PUBLIC_ ======
# Supabase Dashboard -> Project Settings -> API -> service_role. Dùng cho tạo đơn + webhook thanh toán.
SUPABASE_SERVICE_ROLE_KEY=

# ====== Thanh toán VietQR (tài khoản nhận tiền THẬT của bạn) ======
# Mã ngân hàng theo VietQR: MB, VCB, TCB, ACB, BIDV, ... (xem https://api.vietqr.io/v2/banks)
BANK_BIN=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=HSK LEARNING PRO

# ====== Webhook ngân hàng (SePay / Casso / tương thích) - đặt ÍT NHẤT 1 trong 2 ======
# Cách 1: API key. Trên SePay chọn kiểu chứng thực "API Key", webhook gửi header "Authorization: Apikey <key>".
#   Sinh key:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_API_KEY=
# Cách 2: HMAC-SHA256 trên body, header x-signature (và tùy chọn x-timestamp)
PAYMENT_WEBHOOK_SECRET=
# URL webhook cần khai báo với nhà cung cấp:  https://TEN-MIEN-CUA-BAN/api/payment/webhook

# ====== Rate limit dùng chung nhiều instance (khuyến nghị khi chạy serverless / nhiều server) ======
# Upstash Redis (free tier). Bỏ trống -> dùng bộ nhớ trong tiến trình (đủ cho 1 VPS).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ====== Audio CDN (sau khi chạy tools/pregenerate_audio.py --upload) ======
AUDIO_CDN_BASE=

# ====== Cảnh báo doanh thu / lỗi qua Telegram (tùy chọn) ======
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====== Hiển thị trong trang pháp lý ======
NEXT_PUBLIC_SUPPORT_EMAIL=support@ten-mien-cua-ban.com
